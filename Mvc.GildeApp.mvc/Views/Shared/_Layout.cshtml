@{
    var title = ViewData["Title"] as string;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(string.IsNullOrEmpty(title) ? "GildeApp" : title + " · GildeApp")</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="shell topbar-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark"></span>
                GildeApp
            </a>
            <nav class="topnav">
                <a asp-controller="Home" asp-action="Index">Tourneys</a>
                <a class="btn btn-primary btn-sm" asp-controller="Tourneys" asp-action="Create">New tourney</a>
            </nav>
        </div>
    </header>

    <main class="shell page">
        @if (TempData["Error"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="alert alert-error" role="alert">@errorMessage</div>
        }
        @if (TempData["Notice"] is string noticeMessage && !string.IsNullOrWhiteSpace(noticeMessage))
        {
            <div class="alert alert-notice" role="status">@noticeMessage</div>
        }

        @RenderBody()
    </main>

    <footer class="footer">
        <div class="shell">GildeApp — scores come in from the judges' phones.</div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
