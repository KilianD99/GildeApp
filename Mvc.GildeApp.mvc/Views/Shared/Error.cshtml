@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="page-head">
    <h1>Something went wrong</h1>
    <p class="lede">The page could not be loaded. Try again, and if it keeps happening check that the API is running.</p>
</div>

@if (Model.ShowRequestId)
{
    <p class="muted mono">Request ID: @Model.RequestId</p>
}

<a class="btn" asp-controller="Home" asp-action="Index">Back to the tourneys</a>
