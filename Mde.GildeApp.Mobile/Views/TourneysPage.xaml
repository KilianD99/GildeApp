<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:GildeApp.Mobile.Models"
             x:Class="GildeApp.Mobile.Views.TourneysPage"
             Title="Tourneys">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="Running now" Style="{StaticResource H1}" />
                <Label Text="{Binding JudgeLine}" Style="{StaticResource Lede}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="Change"
                    Style="{StaticResource SecondaryButton}"
                    WidthRequest="90"
                    Command="{Binding ChangeJudgeCommand}" />
        </Grid>

        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               TextColor="{StaticResource Red}"
               BackgroundColor="{StaticResource RedSoft}"
               Padding="12"
               FontSize="14" />

        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Tourneys}"
                            SelectionMode="Single"
                            SelectionChanged="OnTourneySelected">

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="20" Spacing="8">
                        <Label Text="Nothing running"
                               FontSize="17"
                               FontAttributes="Bold"
                               HorizontalOptions="Center" />
                        <Label Style="{StaticResource Lede}"
                               HorizontalTextAlignment="Center"
                               Text="A tourney shows up here once it has been started on the website. Pull down to check again." />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TourneyModel">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Name}" FontSize="17" FontAttributes="Bold" />
                                <Label Text="{Binding Subtitle}" Style="{StaticResource Lede}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>