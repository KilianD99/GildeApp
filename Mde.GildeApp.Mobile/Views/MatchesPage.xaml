<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:GildeApp.Mobile.Core.Models"
             x:Class="GildeApp.Mobile.Views.MatchesPage"
             Title="{Binding TourneyName}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">

        <Label Grid.Row="0"
               Style="{StaticResource Lede}"
               Text="Tap a match to score it. A match someone else is already on cannot be opened." />

        <Label Grid.Row="1"
               Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               TextColor="{StaticResource Red}"
               BackgroundColor="{StaticResource RedSoft}"
               Padding="12"
               FontSize="14" />

        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsBusy}"
                     Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Matches}"
                            SelectionMode="Single"
                            SelectionChanged="OnMatchSelected">

                <CollectionView.EmptyView>
                    <Label Padding="20"
                           Style="{StaticResource Lede}"
                           HorizontalTextAlignment="Center"
                           Text="No matches in this tourney yet." />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:MatchModel">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">

                                <!-- Colour bar: green free, amber taken, grey done. -->
                                <BoxView Grid.Column="0"
                                         WidthRequest="4"
                                         CornerRadius="2"
                                         Color="{Binding StateColor}" />

                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" />
                                    <Label Text="{Binding StateLine}"
                                           FontSize="13"
                                           TextColor="{Binding StateColor}" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="{Binding ScoreLine}"
                                       FontSize="19"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </RefreshView>

    </Grid>

</ContentPage>
